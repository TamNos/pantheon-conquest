# .env.example

# Discord Bot Token
DISCORD_TOKEN=your_discord_token_here

# Database URL
DATABASE_URL=your_database_url_here

# Redis URL
REDIS_URL=your_redis_url_here

# API Configuration
API_BASE_URL=your_api_base_url_here
API_KEY=your_api_key_here

# React App Settings
REACT_APP_API_URL=your_react_app_api_url_here
REACT_APP_SOME_SETTING=your_setting_here